; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Glade Quest"
config/description="A tiny top-down action-adventure proof of concept."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.0784, 0.0784, 0.125, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sound="*res://scripts/autoload/sound.gd"

[display]

window/size/viewport_width=256
window/size/viewport_height=224
window/size/window_width_override=768
window/size/window_height_override=672
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://assets/ui/theme.tres"

